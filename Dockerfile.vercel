FROM twentycrm/twenty:v2.50.1
ENV PG_SSL_ALLOW_SELF_SIGNED=true
ENV NODE_TLS_REJECT_UNAUTHORIZED=0
EXPOSE 80
USER root
COPY vercel-listen.js /vercel-listen.js
COPY vercel-entrypoint.sh /vercel-entrypoint.sh
RUN chmod +x /vercel-entrypoint.sh
ENTRYPOINT ["/vercel-entrypoint.sh"]
CMD ["node", "dist/main"]
